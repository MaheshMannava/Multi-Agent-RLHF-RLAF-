{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interactive Debugging Sample",
  "type": "object",
  "required": [
    "bug_id",
    "bug_type",
    "buggy_code",
    "correct_code",
    "tests",
    "description",
    "expected_patch"
  ],
  "properties": {
    "bug_id": {
      "type": "string",
      "pattern": "^(syntax|logic)_[0-9]{3,}$"
    },
    "bug_type": {
      "type": "string",
      "enum": ["syntax", "logic"]
    },
    "bug_family": {
      "type": "string"
    },
    "buggy_code": {
      "type": "string",
      "minLength": 1
    },
    "correct_code": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "expected_patch": {
      "type": "object",
      "required": ["patch_type", "line", "explanation"],
      "properties": {
        "patch_type": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "old_text": {
          "type": "string"
        },
        "new_text": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test"]
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
